
@startuml

!include styles.puml

title Smart Community Services Platform - Software Architecture
header ICT602 - Software Engineering | Group 1 | MEL_S2_2026-1

top to bottom direction

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho

skinparam nodesep 35
skinparam ranksep 45

' =========================================
' PRESENTATION LAYER - BLUE
' =========================================

package "Presentation Layer" #DCEBFA {
  component "ConsoleUI" as UI #B9D9F4
}

' =========================================
' APPLICATION LAYER - GREEN
' =========================================

package "Application Layer" #E3F2E5 {
  component "ServiceRequestService" as SRS #BFE3C7
}

' =========================================
' DOMAIN LAYER - YELLOW
' =========================================

package "Domain Layer" #FFF1D6 {
  component "Service Request Domain Model" as DOMAIN #F8DFA4
}

' =========================================
' PERSISTENCE LAYER - PURPLE
' =========================================

package "Persistence Layer" #EDE4F7 {
  interface "ServiceRequestRepository" as REPO
  component "InMemoryServiceRequestRepository" as MEM #D8C4EF
}

' =========================================
' DEPENDENCIES
' =========================================

UI -down-> SRS : invokes

SRS -down-> DOMAIN : uses domain objects
SRS -down-> REPO : saves / retrieves

MEM ..|> REPO : implements

' =========================================
' NOTES
' =========================================

note right of DOMAIN
  ServiceRequest
  Location
  Feedback
  MaintenanceTeam
  User and role classes
  RequestStatus
  RequestPriority
end note

note right of MEM
  Stores requests using
  Java collections
end note

caption Task 2 - Layered Architecture for Service Request Management

@enduml
