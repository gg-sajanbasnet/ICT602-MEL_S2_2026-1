
package "Service Request Management" #E3F2E5 {

  class ServiceRequest {
    - requestId: String
    - category: String
    - description: String
    - reportedAt: LocalDateTime
    - status: RequestStatus
    - priority: RequestPriority
    --
    + updateStatus(status: RequestStatus): void
    + setPriority(priority: RequestPriority): void
    + assignTeam(team: MaintenanceTeam): void
  }

  class Location {
    - latitude: double
    - longitude: double
    - address: String
  }

  class MaintenanceTeam {
    - teamId: String
    - teamName: String
    --
    + addMember(staff: MaintenanceStaff): void
  }

  class Feedback {
    - feedbackId: String
    - rating: int
    - comment: String
    - submittedAt: LocalDateTime
  }

  class ServiceRequestService {
    + submitRequest(resident: Resident, category: String, description: String, location: Location): ServiceRequest
    + reviewRequest(employee: CouncilEmployee, request: ServiceRequest, priority: RequestPriority): void
    + assignRequest(employee: CouncilEmployee, request: ServiceRequest, team: MaintenanceTeam): void
    + updateProgress(staff: MaintenanceStaff, request: ServiceRequest, status: RequestStatus): void
    + submitFeedback(resident: Resident, request: ServiceRequest, rating: int, comment: String): Feedback
    + trackRequest(requestId: String): RequestStatus
  }

  enum RequestStatus {
    SUBMITTED
    UNDER_REVIEW
    ASSIGNED
    IN_PROGRESS
    COMPLETED
  }

  enum RequestPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
  }
}

' =========================================
' DOMAIN RELATIONSHIPS
' =========================================

Resident "1" -- "0..*" ServiceRequest : submits

Resident "1" -- "0..*" Feedback : provides

ServiceRequest "1" *-- "1" Location : has

ServiceRequest "0..*" --> "0..1" MaintenanceTeam : assigned to

ServiceRequest "1" -- "0..1" Feedback : receives

MaintenanceTeam "0..1" -- "0..*" MaintenanceStaff : includes

CouncilEmployee "0..1" -- "0..*" ServiceRequest : manages

' =========================================
' BUSINESS RULES
' =========================================


