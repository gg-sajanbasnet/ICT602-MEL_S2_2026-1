
package "User Management" #DCEBFA {

  abstract class User {
    - userId: String
    - name: String
    - email: String
    - passwordHash: String
    --
    + updateProfile(name: String, email: String): void
  }

  class Resident {
    - address: String
    - phone: String
  }

  class CouncilEmployee {
    - employeeId: String
    - department: String
  }

  class MaintenanceStaff {
    - staffId: String
  }

  class Administrator {
    - adminId: String
  }
}

User <|-- Resident
User <|-- CouncilEmployee
User <|-- MaintenanceStaff
User <|-- Administrator
