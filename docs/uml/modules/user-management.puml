
' =========================================
' USER MANAGEMENT MODULE
' =========================================

abstract class User {
  - userId: String
  - name: String
  - email: String
  - passwordHash: String
  --
  + updateProfile(): void
}

class Resident {
  - address: String
  - phone: String
  + submitRequest(): void
  + trackRequest(): void
}

class CouncilEmployee {
  - employeeId: String
  - department: String
  + reviewRequest(): void
  + assignTeam(): void
}

class MaintenanceStaff {
  - staffId: String
  + updateRequestStatus(): void
}

class Administrator {
  - adminId: String
  + manageUsers(): void
}

' =========================================
' INHERITANCE RELATIONSHIPS
' =========================================

User <|-- Resident
User <|-- CouncilEmployee
User <|-- MaintenanceStaff
User <|-- Administrator
