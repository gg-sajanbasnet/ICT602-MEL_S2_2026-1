
' =========================================
' FACILITY BOOKING MANAGEMENT MODULE
' =========================================

package "Facility Booking Management" {

  class Facility {
    - facilityId: String
    - name: String
    - description: String
    - address: String
    - hourlyRate: BigDecimal
    - active: boolean
    --
  }

  class FacilityBooking {
    - bookingId: String
    - startTime: LocalDateTime
    - endTime: LocalDateTime
    - status: BookingStatus
    - createdAt: LocalDateTime
    --
    + confirmBooking(): void
    + cancelBooking(): void
  }

  class Payment {
    - paymentId: String
    - amount: BigDecimal
    - transactionReference: String
    - status: PaymentStatus
    --
    + recordPayment(): void
  }

  class FacilityBookingService {
    + checkAvailability(facility: Facility, start: LocalDateTime, end: LocalDateTime): boolean
    + createBooking(resident: Resident, facility: Facility, start: LocalDateTime, end: LocalDateTime): FacilityBooking
    + cancelBooking(booking: FacilityBooking): void
  }

  enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
  }

  enum PaymentStatus {
    PENDING
    SUCCESSFUL
    FAILED
    REFUNDED
  }
}

' =========================================
' FACILITY BOOKING RELATIONSHIPS
' =========================================

Resident "1" -- "0..*" FacilityBooking : makes

Facility "1" -- "0..*" FacilityBooking : reserved through

FacilityBooking "1" -- "0..1" Payment : payment

FacilityBooking ..> BookingStatus : uses
Payment ..> PaymentStatus : uses
FacilityBookingService ..> Facility : checks availability
FacilityBookingService ..> FacilityBooking : manages
FacilityBookingService ..> Resident : books for

note right of FacilityBookingService
  A facility cannot have overlapping
  confirmed bookings.

  Booking start time must be
  earlier than end time.
end note
